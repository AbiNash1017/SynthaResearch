# OpenRouter LLM Configuration
# Both OPENROUTER_API_KEY and OPENROUTER_MODEL are required and must be configured here in .env.
# Example model names: openai/gpt-4o, openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat, google/gemini-2.5-flash, etc.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=syntharesearch

# Authentication Configuration
SECRET_KEY=your_super_secret_jwt_key_here_change_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
